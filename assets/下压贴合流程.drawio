<mxfile><diagram id="flow" name="下压流程"><mxGraphModel pageWidth="680" pageHeight="790"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" vertex="1" style="text;html=1;fontSize=23;fontStyle=1;fontFamily=Microsoft YaHei;" value="下压与贴合调整｜拟议流程"><mxGeometry x="25" y="10" width="630" height="60" as="geometry"/></mxCell><mxCell id="eab" parent="1" edge="1" source="a" target="b" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;strokeColor=#426f81;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ebc" parent="1" edge="1" source="b" target="c" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;strokeColor=#426f81;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ecd" parent="1" edge="1" source="c" target="d" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;strokeColor=#426f81;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ede" parent="1" edge="1" source="d" target="e" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;strokeColor=#426f81;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eef" parent="1" edge="1" source="e" target="f" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;strokeColor=#426f81;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eeg" parent="1" edge="1" source="e" target="g" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;strokeColor=#426f81;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eeh" parent="1" edge="1" source="e" target="h" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;strokeColor=#426f81;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#12344c;strokeColor=#426f81;fillColor=#edf5f7;" value="&lt;b&gt;力控启动请求&lt;/b&gt;&lt;br&gt;下压开关已开 → 拒绝上使能"><mxGeometry x="60" y="85" width="490" height="72" as="geometry"/></mxCell><mxCell id="b" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#12344c;strokeColor=#426f81;fillColor=#edf5f7;" value="&lt;b&gt;普通拖动 → 下压开关接通&lt;/b&gt;&lt;br&gt;仅允许大量程；切换小量程退出下压并停机"><mxGeometry x="60" y="180" width="490" height="72" as="geometry"/></mxCell><mxCell id="c" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#12344c;strokeColor=#426f81;fillColor=#edf5f7;" value="&lt;b&gt;建立压力｜锁住 XY 和绕 Z&lt;/b&gt;&lt;br&gt;目标力缓增；按力误差算速度，再积分为 Z 目标"><mxGeometry x="60" y="275" width="490" height="72" as="geometry"/></mxCell><mxCell id="d" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#12344c;strokeColor=#426f81;fillColor=#edf5f7;" value="&lt;b&gt;判定建立接触&lt;/b&gt;&lt;br&gt;缓增结束，47～53 N 连续 5 秒；出带重新计时"><mxGeometry x="60" y="370" width="490" height="72" as="geometry"/></mxCell><mxCell id="e" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#12344c;strokeColor=#426f81;fillColor=#edf5f7;" value="&lt;b&gt;进入贴合调整｜不等于已经面接触&lt;/b&gt;&lt;br&gt;允许沿 XY 和绕 Z 调整，不接受手动 Z 拖动"><mxGeometry x="60" y="465" width="490" height="72" as="geometry"/></mxCell><mxCell id="f" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#12344c;strokeColor=#426f81;fillColor=#edf5f7;" value="&lt;b&gt;低于 47 N&lt;/b&gt;&lt;br&gt;有接触时慢速向下补压"><mxGeometry x="20" y="570" width="188" height="78" as="geometry"/></mxCell><mxCell id="g" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#12344c;strokeColor=#426f81;fillColor=#edf5f7;" value="&lt;b&gt;47～53 N&lt;/b&gt;&lt;br&gt;保持当前目标高度"><mxGeometry x="221" y="570" width="170" height="78" as="geometry"/></mxCell><mxCell id="h" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#12344c;strokeColor=#426f81;fillColor=#edf5f7;" value="&lt;b&gt;高于 53 N&lt;/b&gt;&lt;br&gt;不继续下压；暂停平移与旋转"><mxGeometry x="404" y="570" width="245" height="78" as="geometry"/></mxCell><mxCell id="i" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#12344c;strokeColor=#426f81;fillColor=#edf5f7;" value="&lt;b&gt;退出&lt;/b&gt;&lt;br&gt;关下压 → 同步实际位姿，不自动抬升；关力控 → 停机"><mxGeometry x="60" y="684" width="550" height="72" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
